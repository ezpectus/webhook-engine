{
  // ЗНАЧЕНИЯ ЛОКАЛЬНО-ОПТИМАЛЬНЫЕ, НЕ ПРОД-РЕКОМЕНДУЕМЫЕ.
  // Подобраны для демо/учёбы: ретраи и sweeper видны живьём за секунды,
  // backpressure срабатывает на наблюдаемой нагрузке. Прод-направление
  // (что менять при росте) — docs/guides/open_questions.md, конец файла.
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=webhook_engine;Username=engine;Password=engine",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF спамит SQL в консоль — глушим для читаемости демо
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Dedup": {
    // Окно Redis-дедупа. PG unique-индекс держит навсегда (В8),
    // Redis — быстрый фильтр на 24ч как у Stripe.
    "WindowHours": 24
  },
  "Queue": {
    // Канал в памяти. 10к хватает с запасом на локальную машину;
    // прод бы уменьшал, чтобы backpressure кусал раньше.
    "Capacity": 10000,
    // Потолок PG-беклога → ingest вернёт 503. Снижено со 100000:
    // на локали 10к pending достижимо и backpressure виден живьём.
    "PendingThreshold": 10000
  },
  "Sweeper": {
    // Тик подъёма due-работы из PG. 2с — локальный оптимум: ретраи
    // backoff 1/2/4/8с стреляют почти по плану, а не сливаются в 10с.
    // Прод: 5–15с, чтобы скан не дёргал БД постоянно.
    "IntervalSeconds": 2,
    "BatchSize": 500,
    // Лиз InFlight → sweeper реклеймит протухшее. 5 мин спокойно
    // переживает 10-секундный delivery timeout + ретраи.
    "InFlightTimeoutMinutes": 5
  },
  "Delivery": {
    "WorkerParallelism": 4,
    // HTTP-таймаут отправки. 10с: mockreceiver mode=slow (15с)
    // гарантированно ловится как retryable timeout.
    "SenderTimeoutSeconds": 10
  },
  "Retry": {
    "BaseDelaySeconds": 1,
    "MaxDelaySeconds": 300,
    "MaxAttempts": 5
  },
  "Stats": {
    // TTL снапшота /stats и /metrics. Дашборд поллит раз в 2с —
    // кэш 3с сводит seq-scan до максимум 1 запроса за тик поллинга.
    "CacheTtlSeconds": 3
  },
  "AllowedHosts": "*"
}
