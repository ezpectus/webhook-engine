{
  // LOCALLY-OPTIMAL VALUES, NOT PROD-RECOMMENDED.
  // Tuned for demo/learning: retries and the sweeper are visible live
  // within seconds, backpressure fires at observable load. Prod
  // direction (what to change at scale) — docs/guides/open_questions.md.
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=webhook_engine;Username=engine;Password=engine",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF spams SQL to the console — muted for demo readability
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Dedup": {
    // Dedup window. Redis marker lives WindowHours from first sight
    // (rolling); the PG unique index holds only the time bucket
    // (H-1: same content next window = a new event). Sub-hour values
    // allowed: 0.002 ≈ 7s — handy for e2e checks of the boundary.
    "WindowHours": 24
  },
  "Queue": {
    // In-memory channel. 10k is generous for a local machine;
    // prod would lower it so backpressure bites earlier.
    "Capacity": 10000,
    // PG-backlog ceiling → ingest returns 503. Lowered from 100000:
    // 10k pending is reachable locally, backpressure is visible live.
    "PendingThreshold": 10000
  },
  "Sweeper": {
    // Tick that pulls due work from PG. 2s is a local optimum: the
    // 1/2/4/8s retry backoff fires nearly on plan instead of merging
    // into a 10s cadence. Prod: 5–15s so the scan doesn't pester the DB.
    "IntervalSeconds": 2,
    "BatchSize": 500,
    // InFlight lease → the sweeper reclaims stale ones. 5 min safely
    // outlives the 10s delivery timeout plus retries.
    "InFlightTimeoutMinutes": 5
  },
  "Delivery": {
    "WorkerParallelism": 4,
    // HTTP send timeout. 10s: mockreceiver mode=slow (15s) is
    // guaranteed to land as a retryable timeout.
    "SenderTimeoutSeconds": 10
  },
  "Retry": {
    "BaseDelaySeconds": 1,
    "MaxDelaySeconds": 300,
    "MaxAttempts": 5
  },
  "Stats": {
    // TTL of the /stats and /metrics snapshot. The dashboard polls
    // every 2s — the 3s cache caps it at one seq-scan per poll tick.
    "CacheTtlSeconds": 3
  },
  "AllowedHosts": "*"
}
