{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=webhook_engine;Username=engine;Password=engine",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Dedup": {
    "WindowHours": 24
  },
  "Queue": {
    "Capacity": 10000,
    "PendingThreshold": 100000
  },
  "Sweeper": {
    "IntervalSeconds": 10,
    "BatchSize": 500,
    "InFlightTimeoutMinutes": 5
  },
  "Delivery": {
    "WorkerParallelism": 4
  },
  "Retry": {
    "BaseDelaySeconds": 1,
    "MaxDelaySeconds": 300,
    "MaxAttempts": 5
  },
  "AllowedHosts": "*"
}
