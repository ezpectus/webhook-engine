<mxfile host="app.diagrams.net">
  <diagram name="ER — webhook-engine" id="er1">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="webhooks" value="&lt;b&gt;WebhookEndpoints&lt;/b&gt;&lt;br&gt;——————————&lt;br&gt;PK&nbsp;&nbsp;Id : uuid&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Url : varchar(2048) · IDX&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Secret : text — HMAC-ключ&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;RateLimitPerSecond : int&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;IsActive : bool&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;CreatedAt : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="300" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="events" value="&lt;b&gt;NotificationEvents&lt;/b&gt;&lt;br&gt;——————————&lt;br&gt;PK&nbsp;&nbsp;Id : uuid&lt;br&gt;FK&nbsp;&nbsp;WebhookId : uuid&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;IdempotencyKey : varchar(64) · UNIQUE — граница dedup&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Payload : jsonb&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Status : int — Pending·InFlight·RetryScheduled·Delivered·DeadLettered&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;AttemptCount : int&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;NextAttemptAt : timestamptz — durable-расписание&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;DeliveredAt : timestamptz&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;CreatedAt : timestamptz&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;UpdatedAt : timestamptz — lease-метка&lt;br&gt;&lt;br&gt;IDX (Status, NextAttemptAt) — due-scan sweeper'а" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="480" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="attempts" value="&lt;b&gt;DeliveryAttempts&lt;/b&gt;&lt;br&gt;——————————&lt;br&gt;PK&nbsp;&nbsp;Id : uuid&lt;br&gt;FK&nbsp;&nbsp;EventId : uuid · IDX(EventId, AttemptNumber)&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;AttemptNumber : int&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;AttemptedAt : timestamptz&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;ResponseStatusCode : int — null при timeout/conn error&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Error : text&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Succeeded : bool&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;DurationMs : int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="460" y="380" width="420" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="dlq" value="&lt;b&gt;DeadLetters&lt;/b&gt;&lt;br&gt;——————————&lt;br&gt;PK&nbsp;&nbsp;Id : uuid&lt;br&gt;FK&nbsp;&nbsp;EventId : uuid · IDX&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Reason : text&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;DeadLetteredAt : timestamptz · IDX&lt;br&gt;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;ReplayedAt : timestamptz — null = живая запись" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="330" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="rel1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERoneToMany;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="webhooks" target="events">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERoneToMany;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="events" target="attempts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERzeroToOne;exitX=0;exitY=0.7;entryX=1;entryY=0.3;" edge="1" parent="1" source="events" target="dlq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
