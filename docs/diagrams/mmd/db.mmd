erDiagram
    Webhooks ||--o{ Events : "receives"
    Events ||--o{ DeliveryAttempts : "attempt history"
    Events ||--o{ DeadLetters : "terminal + audit"

    Webhooks {
        uuid Id PK
        varchar_2048 Url "IDX"
        text Secret "HMAC signing key, nullable"
        int RateLimitPerSecond "token bucket"
        bool IsActive
        timestamptz CreatedAt
    }

    Events {
        uuid Id PK
        uuid WebhookId FK
        varchar_64 IdempotencyKey "UNIQUE — hard dedup boundary"
        jsonb Payload
        int Status "0 Pending·1 InFlight·2 RetryScheduled·3 Delivered·4 DeadLettered"
        int AttemptCount
        int ClaimVersion "lease-versioning (H-3 guard)"
        timestamptz NextAttemptAt "durable retry schedule; IDX(Status,NextAttemptAt)"
        timestamptz DeliveredAt "nullable"
        timestamptz CreatedAt
        timestamptz UpdatedAt "nullable — lease mark; IDX feeds ORDER BY"
    }

    DeliveryAttempts {
        bigint Id PK "identity"
        uuid EventId FK "IDX(EventId,AttemptNumber)"
        int AttemptNumber "resets to 1 on replay — two cycles interleave by AttemptedAt"
        timestamptz AttemptedAt
        int ResponseStatusCode "null on timeout/conn error"
        text Error
        bool Succeeded
        int DurationMs
    }

    DeadLetters {
        bigint Id PK "identity"
        uuid EventId FK "IDX"
        text Reason "why it's here — must be obvious a week later"
        timestamptz DeadLetteredAt "IDX"
        timestamptz ReplayedAt "null = live DLQ entry; set = audit row"
    }
