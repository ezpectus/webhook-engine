classDiagram
    direction LR

    namespace Core.Models {
        class NotificationEvent {
            +Guid Id
            +Guid WebhookId
            +string IdempotencyKey "UNIQUE — hard dedup boundary"
            +string Payload "jsonb"
            +EventStatus Status
            +int AttemptCount
            +int ClaimVersion "H-3 lease guard"
            +DateTimeOffset? NextAttemptAt
            +DateTimeOffset? DeliveredAt
            +DateTimeOffset CreatedAt
            +DateTimeOffset? UpdatedAt "lease"
        }
        class WebhookEndpoint {
            +Guid Id
            +string Url
            +string? Secret "HMAC"
            +int RateLimitPerSecond
            +bool IsActive
            +DateTimeOffset CreatedAt
        }
        class DeliveryAttempt {
            +long Id "identity"
            +Guid EventId
            +int AttemptNumber "resets on replay"
            +DateTimeOffset AttemptedAt
            +int? ResponseStatusCode
            +string? Error
            +bool Succeeded
            +int DurationMs
        }
        class DeadLetterItem {
            +long Id "identity"
            +Guid EventId
            +string Reason
            +DateTimeOffset DeadLetteredAt
            +DateTimeOffset? ReplayedAt "null = live DLQ row"
        }
        class EventStatus {
            <<enumeration>>
            Pending
            InFlight
            RetryScheduled
            Delivered
            DeadLettered
        }
    }

    namespace Core.Abstractions {
        class IDeduplicationStore {
            <<interface>>
            +GetEventIdAsync(key) Guid "Guid.Empty on miss"
            +MarkAsync(key, eventId, window)
        }
        class IEventQueue {
            <<interface>>
            +TryEnqueue(ev) bool
            +ReadAllAsync(ct)
        }
        class IWebhookRateLimiter {
            <<interface>>
            +AcquireDelayAsync(id, rps) TimeSpan
        }
        class IRetryScheduler {
            <<interface>>
            +ScheduleAsync(id, dueAt)
            +ReadDueAsync(now)
        }
        class IStatusFeed {
            <<interface>>
            +PublishAsync(id, status)
        }
    }

    namespace Core.Algorithms {
        class TokenBucket {
            -double _tokens
            -object _gate
            +TryTake() bool "O(1) lazy refill"
            +TimeUntilAvailable() TimeSpan
        }
        class BackoffPolicy {
            +ComputeDelay(attempt) TimeSpan "O(1)"
            +IsExhausted(n) bool
            +MaxAttempts
        }
        class HeapRetryScheduler {
            -PriorityQueue _heap "O(log n) push/pop"
            -Dict~Guid,long~ _versions "lazy deletion"
            +ScheduleAsync(id, dueAt)
            +ReadDueAsync(now)
        }
        class EngineMetrics {
            +Interlocked counters
            +DedupHits, SendsOk...
            +StaleReclaims
        }
        class ConsistentHashRing {
            +AddNode / RemoveNode / GetNode(key)
            "GetNode linear O(points); not wired — scale wave"
        }
    }

    namespace Infrastructure {
        class WebhookEngineDbContext {
            DbSet Events, Webhooks, Attempts, DeadLetters
            +indexes in OnModelCreating
        }
        class RedisDeduplicationStore {
            "fail-open: Redis down -> PG decides"
            "stores eventId as value (H-1)"
        }
        class EventQueue {
            Channel bounded 10k "TryEnqueue + rollback"
        }
        class TokenBucketRateLimiter {
            ConcurrentDict~Guid, TokenBucket~
        }
        class WebhookSender {
            +SendAsync(url, payload, ct, secret?)
            "HMAC + retryable classification"
        }
        class StatsCache {
            "snapshot TTL 3s — GROUP BY is O(n) per refresh"
        }
    }

    namespace Api {
        class Program {
            DI + /health(PG,Redis) + migrations
        }
        class Endpoints {
            <<static>>
            /events /webhooks /deadletters
            /stats /metrics /health
        }
        class DeliveryWorker {
            xN readers (Delivery:WorkerParallelism, def 4)
            claim->send->ack->schedule
        }
        class SweeperService {
            stale-reclaim + heap/scan -> claim->enqueue
        }
        class SignalRStatusFeed {
            publish -> /hubs/status
        }
        class StatusFeedHub {
            SignalR hub /hubs/status
        }
    }

    IDeduplicationStore ..|> RedisDeduplicationStore : implements
    IEventQueue ..|> EventQueue : implements
    IWebhookRateLimiter ..|> TokenBucketRateLimiter : implements
    IRetryScheduler ..|> HeapRetryScheduler : implements
    IStatusFeed ..|> SignalRStatusFeed : implements

    WebhookEndpoint "1" --> "0..*" NotificationEvent
    NotificationEvent "1" --> "0..*" DeliveryAttempt
    NotificationEvent "1" --> "0..*" DeadLetterItem
    NotificationEvent --> EventStatus

    TokenBucketRateLimiter --> TokenBucket : creates
    Endpoints --> IDeduplicationStore
    Endpoints --> IEventQueue
    Endpoints --> StatsCache
    Endpoints --> WebhookEngineDbContext
    DeliveryWorker --> IEventQueue
    DeliveryWorker --> IRetryScheduler
    DeliveryWorker --> BackoffPolicy
    DeliveryWorker --> WebhookSender
    DeliveryWorker --> IWebhookRateLimiter
    DeliveryWorker --> IStatusFeed
    SweeperService --> IRetryScheduler
    SweeperService --> IEventQueue
    Program --> DeliveryWorker : hosts
    Program --> SweeperService : hosts
