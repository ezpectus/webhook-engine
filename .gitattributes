# Normalize line endings: text files get CRLF in the working copy on
# Windows but are stored as LF in the repo — kills the "LF will be
# replaced by CRLF" warning spam and whole-file diffs.
* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.md text
*.json text
*.yml text
*.yaml text
*.ts text
*.tsx text
*.css text
*.html text
*.sql text
*.mmd text
*.drawio text
Dockerfile text
*.dockerignore text
.gitignore text
